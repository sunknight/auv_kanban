{
  "name": "auv-kanban",
  "version": "0.2.0",
  "description": "Markdown + 目录驱动的人/智能体共用看板",
  "type": "module",
  "bin": {
    "kanban": "./bin/kanban"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "cd src/web && npm run build",
    "build:all": "npm run build:web && npm run build",
    "prepublishOnly": "npm run build:all && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:server": "tsx watch src/bin.ts serve --port 38311",
    "stop": "lsof -tiTCP:38311 -sTCP:LISTEN | xargs kill 2>/dev/null; sleep 1; lsof -tiTCP:38311 -sTCP:LISTEN | xargs kill -9 2>/dev/null; true",
    "start": "node bin/kanban serve --port 38311",
    "restart": "npm run stop && npm run build && npm run start",
    "restart:all": "npm run stop && npm run build:all && npm run start"
  },
  "keywords": [
    "kanban",
    "board",
    "markdown",
    "agent",
    "ai",
    "task-management",
    "cli",
    "productivity"
  ],
  "author": "sunknight",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://www.npmjs.com/package/auv-kanban",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunknight/auv-kanban.git"
  },
  "bugs": {
    "url": "https://github.com/sunknight/auv-kanban/issues"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/static": "^8.0.0",
    "socket.io": "^4.7.0",
    "chokidar": "^4.0.0",
    "js-yaml": "^4.1.0",
    "yargs": "^17.7.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "tsx": "^4.16.0",
    "@types/node": "^22.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/yargs": "^17.0.32"
  },
  "files": ["dist", "bin", "skill", "README.md"]
}
